#!/usr/bin/env bash
LOG_FILE="/var/log/easyedr/edr_events.jsonl"

usage() {
    echo "Usage: easyedr logs [options]"
    echo "  -f, --follow        prints logs in real-time"
    echo "  -w, --warnings      shows only warnings"
    echo "  -a, --alerts        shows only alerts"
    echo "  -n, --lines N       number of lines to display (default: 50)"
    echo "  -h, --help          shows this "
    exit 0
}

FOLLOW=false
FILTER=""
LINES=50

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--follow) FOLLOW=true; shift ;;
        -w|--warnings) FILTER="Warning"; shift ;;
        -a|--alerts) FILTER="Warning"; shift ;;
        -n|--lines) LINES="$2"; shift 2 ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

if [[ ! -f "$LOG_FILE" ]]; then
    echo "Log file not found (?): $LOG_FILE"
    exit 1
fi

if $FOLLOW; then
    if [[ -n "$FILTER" ]]; then
        tail -f "$LOG_FILE" | grep --line-buffered "$FILTER"
    else
        tail -f "$LOG_FILE"
    fi
else
    if [[ -n "$FILTER" ]]; then
        tail -n "$LINES" "$LOG_FILE" | grep "$FILTER"
    else
        tail -n "$LINES" "$LOG_FILE"
    fi
fi